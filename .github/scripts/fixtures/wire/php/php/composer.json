{
    "name": "skunkwerkx/hypertabular-dev",
    "description": "Development harness for the hypertabular PHP extension",
    "type": "library",
    "keywords": [
        "csv",
        "tsv",
        "xlsx",
        "ods",
        "parser",
        "tabular",
        "validation",
        "extension",
        "rust"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Brian Buvinghausen"
        }
    ],
    "homepage": "https://github.com/SkunkWerkx/HyperTabular",
    "support": {
        "issues": "https://github.com/SkunkWerkx/HyperTabular/issues",
        "source": "https://github.com/SkunkWerkx/HyperTabular"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpbench/phpbench": "^1.7",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "HyperTabular\\Tests\\": "tests/",
            "HyperTabular\\Bench\\": "bench/"
        }
    },
    "scripts": {
        "test": "@php tools/run-tests.php",
        "bench": "@php tools/run-bench.php"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
