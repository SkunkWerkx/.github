# Workspace JDT options for the VS Code Java extension (devcontainer.json java.settings.url).
# release=disabled: check source against the running JDK's API (25) with each project's own language level (21),
# which is exactly what Gradle does for the Hyper* base trees (-source/-target 21, no --release; see their
# build.gradle.kts). With release=enabled, the Java extension's default, JDT uses JDK 21's API signatures, where
# java.lang.foreign is still a preview API, and flags every FFM call as PreviewAPIUsed. The floor stays guarded by
# each build's checkFloorApi task.
eclipse.preferences.version=1
org.eclipse.jdt.core.compiler.release=disabled
